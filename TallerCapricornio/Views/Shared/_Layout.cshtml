<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Taller Capricornio</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TallerCapricornio.styles.css" asp-append-version="true" />
</head>

<body>
    <header class="encabezado-sitio">
        <div class="encabezado-interno">
            <a class="marca-sitio" asp-controller="Presupuestos" asp-action="Index">
                <strong>CAPRICORNIO</strong>
                <small>Taller de carrocería y pintura</small>
            </a>

            <nav class="menu-sitio">
                <a asp-controller="Presupuestos" asp-action="Index">Historial</a>
                <a asp-controller="Presupuestos" asp-action="Create">Nuevo ingreso</a>
            </nav>
        </div>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
